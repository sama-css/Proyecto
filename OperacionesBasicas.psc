Algoritmo OperacionesBasicas
	Definir digito1, digito2 Como Entero
	Escribir " Ingrese un número entero "
	Leer digito1
	Escribir  " Ingrese un número entero "
	Leer digito2
	Si digito1 es entero Entonces
		total1=digito1+digito2
		total2=digito1-digito2
		total3=digito1*digito2
		total4=digito1/digito2
	FinSi
	Escribir "La suma de los dos números es ", total1
	Escribir "La resta de los dos números es ", total2
	Escribir "La multiplicación de los dos números es ", total3
	Escribir "La divisón de los dos números es ", total4
FinAlgoritmo
