Algoritmo Multiplicación
	Definir multiplicando1, multiplicando2 Como Entero
	Escribir " Ingrese un número para multiplicar "
	Leer multiplicando1
	Escribir " Ingrese un número para multiplicar "
	Leer multiplicando2
	Si multiplicando1 es entero Entonces
		total = multiplicando1 * multiplicando2
	FinSi
	Escribir " El total de la multiplicación es ",  total
	
FinAlgoritmo
