Algoritmo DobleYTriple
	Definir digito Como Entero
	Escribir " Ingrese un número entero al azar "
	Leer digito
	Si digito es entero Entonces
		total1=digito*2
	FinSi
	Escribir  " El doble su número es ", total1
	Si digito es entero Entonces
		total2=digito*3
	FinSi
	Escribir " El triple de su número es ",  total2
	
FinAlgoritmo
