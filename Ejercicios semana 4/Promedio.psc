Algoritmo Promedio
	Definir numero1, numero2, numero3 Como Entero
	Escribir " Ingrese un número entero "
	Leer numero1
	Escribir " Ingrese un número entero "
	Leer numero2
	Escribir " Ingrese un número entero "
	Leer numero3
	Si numero1 es entero Entonces
		suma=numero1+numero2+numero3
	FinSi
	Si suma es entero Entonces
		total=suma/3
	FinSi
	Escribir " El promedio de la suma de los tres números es ", total
	
FinAlgoritmo
